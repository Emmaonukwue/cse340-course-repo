<%- include('partials/header') %>
<main>
    <h2><%= categoryDetails.name %> - <%= title %></h2>
    <p>Here are projects in <%= categoryDetails.name %> category:</p>
    <ul>
        <% projects.forEach(project => { %>
            <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
        <% }); %>
    </ul>
    <hr>
    <p><a href="/edit-category/<%= categoryDetails.category_id %>">Edit Category</a></p>
</main>
<%- include('partials/footer') %>