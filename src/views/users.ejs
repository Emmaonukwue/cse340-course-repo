<%- include('partials/header') %>
<style>
    table {width: 100%;border-collapse: collapse;
    }th, td {padding: 8px;text-align: left;border-bottom: 1px solid #ddd;
    }th {background-color: #f2f2f2;}
</style>
<main>
    <h1><%= title %></h1>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.role_name %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</main>
<%- include('partials/footer') %>