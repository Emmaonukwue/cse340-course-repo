<%- include('partials/header') %>
<main>
    <h2><%= title %></h2>
    <h3>Title: <strong><%= projectDetails.title %></strong></h3>
    <p><strong>Description:</strong> <%= projectDetails.description %></p>
    <p><strong>Date:</strong> <%= projectDetails.formattedDate %></p>
    <p><strong>Location:</strong> <%= projectDetails.location %></p>
    <p><strong>Organization:</strong> <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>
    
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>
    <% } %>

    <hr>
    <p><strong>Categories:</strong><% projectCategories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>"><%= category.name %></a>, 
        <% }); %>
    </p>
    <% if (user && user.role_name === 'admin') { %>
        <a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a>
    <% } %>

    <% if (user) { %>

        <% if (isVolunteer) { %>

            <p class="text-success fw-bold">
                ✓ You are volunteering for this project.
            </p>

            <form action="/project/<%= projectDetails.project_id %>/remove-volunteer"
                method="POST">

                <button type="submit" class="btn btn-danger">
                    Remove Volunteer
                </button>

            </form>

        <% } else { %>

            <form action="/project/<%= projectDetails.project_id %>/add-volunteer"
                method="POST">

                <button type="submit" class="btn btn-primary">
                    Volunteer for this Project
                </button>

            </form>

        <% } %>

    <% } %>
</main>
<%- include('partials/footer') %>